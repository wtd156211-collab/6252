   # 任务注释：这条独立注释留在原来的位置，不能被上面的语句带走
fetch(source = "s3://raw/2026-09-24", retry = 3, timeout = 30, fallback = "s3://raw/2026-09-23")   # 首次抓取，失败就改走前一天的快照
aggregate(keys = "day,region", window = "1d")
        # 下面这条通知语句带着自己的注释，别让它漂到上面去
notify(channel = "#data-alerts", level = "warn", retries = 3, backoff = "exponential", page = "oncall")  # 值班通知
